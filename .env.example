# Application
APP_ENV=development

# PostgreSQL
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db

# Frontend
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Future AI provider configuration
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_MODEL=

# Storage

STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_MB=25

# Text Embeddings

TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TEXT_EMBEDDING_DIMENSION=384
TEXT_EMBEDDING_BATCH_SIZE=32
TEXT_EMBEDDING_DEVICE=cuda

TEXT_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages:"

HNSW_EF_SEARCH=100

# CLIP Visual Embeddings

CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
CLIP_EMBEDDING_DIMENSION=512
CLIP_BATCH_SIZE=32
CLIP_DEVICE=auto
CLIP_HNSW_EF_SEARCH=100

# Reranking

RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

RERANK_CANDIDATE_K=20
RERANK_TOP_K=10

# Context Selection

CONTEXT_MAX_TOKENS=1800
CONTEXT_MAX_ITEMS=8
CONTEXT_MAX_VISUAL_ITEMS=3
CONTEXT_MAX_ITEMS_PER_PAGE=2

VISUAL_CONTEXT_MAX_CHARS=2500