# Application
APP_ENV=development

# PostgreSQL
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db

# Frontend
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Future AI provider configuration
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_MODEL=

# Storage

STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_MB=25

# Text Embeddings

TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TEXT_EMBEDDING_DIMENSION=384
TEXT_EMBEDDING_BATCH_SIZE=32
TEXT_EMBEDDING_DEVICE=cuda

TEXT_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages:"

HNSW_EF_SEARCH=100